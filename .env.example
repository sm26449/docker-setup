# =============================================================================
# docker-setup — environment for docker-compose.pv-stack.yml (+ install.sh)
# =============================================================================
# Copy to .env and fill in. Written 2026-10-23 (two-roles plan P4.1) from the
# 149 names the live .env carried; nothing here is a secret value.
#
# Every variable carries a class tag the configuration-surface map reads
# (pv-stack-ui/scripts/config_surface_map.py):
#   # class: SITE     identity of this installation — host, ports, names, zone
#   # class: SECRET   credential — generate at install, never commit
#   # class: SERVICE  what runs and how often — toggles, intervals, images
#   # class: TUNABLE  behaviour — thresholds, modes
#   # class: UNUSED   present in the live .env, read by nothing (candidate for removal)
# A `# unused:` note means no compose file or template reads the name.

# =============================================================================
# Host
# =============================================================================
# class: SITE
DOCKER_ROOT=/docker-storage
# class: SITE
PUID=1000
# class: SITE
PGID=1000
# class: SITE
TZ=Europe/Bucharest
# The LAN address of this host. Field ESPs, the Ekrano bridges and the
# Grafana renderer callbacks depend on it — reserve it on the router by MAC.
# class: SITE
SERVER_IP=192.168.88.239
# class: SITE
DOCKER_NETWORK=docker-services
# class: SITE
DOCKER_SUBNET=172.20.0.0/16

# =============================================================================
# Mosquitto (broker) + the Victron bridge
# =============================================================================
# class: SITE
MQTT_PORT=1883
# class: SITE
MQTT_WS_PORT=9001
# class: SITE
MQTT_USERNAME=admin
# class: SECRET
MQTT_PASSWORD=changeme
# Second listener used by the mosquitto-bridge container
# class: SITE
MQTT_BRIDGE_PORT=1884
# class: SITE
MQTT_BRIDGE_WS_PORT=9002
# class: SITE
MQTT_BRIDGE_USERNAME=admin
# class: SECRET
MQTT_BRIDGE_PASSWORD=changeme
# The Ekrano GX broker the bridge mirrors (templates/mosquitto)
# class: SITE
REMOTE_MQTT_HOST=192.168.88.235
# class: SITE
REMOTE_MQTT_PORT=8883
# class: SERVICE
REMOTE_MQTT_USE_SSL=true
# class: SITE
REMOTE_MQTT_USERNAME=admin
# class: SECRET
REMOTE_MQTT_PASSWORD=changeme
# class: SERVICE
REMOTE_MQTT_INSECURE=true
# class: SITE
BRIDGE_NAME=victron
# class: TUNABLE
BRIDGE_TOPICS_IN=#
# class: UNUSED
BRIDGE_LOCAL_PREFIX=
# class: TUNABLE
BRIDGE_KEEPALIVE=60
# class: TUNABLE
BRIDGE_RESTART_TIMEOUT=30
# class: TUNABLE
BRIDGE_QOS=1
# MQTT Explorer (web UI)
# class: SITE
MQTT_EXPLORER_PORT=4000
# class: UNUSED
MQTT_EXPLORER_BROKER_HOST=pv-stack-mosquitto
# class: UNUSED
MQTT_EXPLORER_BROKER_PORT=1883

# =============================================================================
# InfluxDB 2.x
# =============================================================================
# class: SITE
INFLUXDB_PORT=8086
# class: SITE
DOCKER_INFLUXDB_INIT_USERNAME=admin
# class: SECRET
DOCKER_INFLUXDB_INIT_PASSWORD=changeme
# class: SITE
DOCKER_INFLUXDB_INIT_ORG=pv-stack
# class: SITE
DOCKER_INFLUXDB_INIT_BUCKET=default
# The operator token every writer and reader uses (SEPLOS_/FRONIUS_/TELEGRAF_/NODERED_ *_TOKEN carry the same value today)
# class: SECRET
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=changeme
# class: SERVICE
DOCKER_INFLUXDB_INIT_MODE=setup

# =============================================================================
# Grafana + image renderer
# =============================================================================
# class: SITE
GRAFANA_PORT=3000
# class: SITE
GF_SECURITY_ADMIN_USER=admin
# class: SECRET
GF_SECURITY_ADMIN_PASSWORD=changeme
# class: SITE
GRAFANA_INFLUXDB_HOST=pv-stack-influxdb
# class: SITE
GRAFANA_INFLUXDB_UID=pv-stack-influxdb
# class: UNUSED
GRAFANA_INFLUXDB_URL=http://pv-stack-influxdb:8086
# Renderer callbacks go through the host IP (SERVER_IP)
# class: SITE
GF_RENDERING_SERVER_URL=http://192.168.88.239:8081/render
# class: SITE
GF_RENDERING_CALLBACK_URL=http://192.168.88.239:3000/
# class: SECRET
GF_RENDERING_RENDERER_TOKEN=changeme
# class: SERVICE
GF_UNIFIED_ALERTING_SCREENSHOTS_CAPTURE=true
# class: SITE
RENDERING_PORT=8081
# class: UNUSED
RENDERING_MODE=clustered
# class: UNUSED
RENDERING_CLUSTERING_MODE=context
# class: UNUSED
RENDERING_CLUSTERING_MAX_CONCURRENCY=5
# class: UNUSED
RENDERING_VERBOSE_LOGGING=false

# =============================================================================
# Node-RED (local-1: the production controllers)
# =============================================================================
# class: SITE
NODERED_PORT=1880
# class: SITE
NODERED_ADMIN_USER=admin
# The plain password is read by scripts (nodered-flows/scripts/diff-live-local.sh), the hash by settings.js
# class: SECRET
NODERED_ADMIN_PASSWORD=changeme
# class: SECRET
NODERED_ADMIN_PASSWORD_HASH=changeme
# class: SECRET
NODE_RED_CREDENTIAL_SECRET=changeme
# class: SECRET
NODERED_INFLUXDB_TOKEN=changeme
# JSON list of the Tuya AC units the thermal flow drives (ids + local keys — a secret); shape: tuya_bridge/README.md
# class: SECRET
TUYA_AC_DEVICES='[]'
# class: UNUSED
NODERED_MQTT_HOST=pv-stack-mosquitto
# class: UNUSED
NODERED_MQTT_PORT=1883

# =============================================================================
# Seplos BMS collector (seplos-modbus-mqtt)
# =============================================================================
# class: SITE
SEPLOS_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# class: TUNABLE
SEPLOS_SERIAL_BAUDRATE=19200
# class: SITE
SEPLOS_MQTT_SERVER=192.168.88.239
# class: SITE
SEPLOS_MQTT_PORT=1883
# class: SITE
SEPLOS_MQTT_USERNAME=seplos
# class: SECRET
SEPLOS_MQTT_PASSWORD=changeme
# class: SITE
SEPLOS_MQTT_PREFIX=seplos
# class: TUNABLE
SEPLOS_MQTT_PUBLISH_MODE=changed
# class: SERVICE
SEPLOS_INFLUXDB_ENABLED=true
# class: SITE
SEPLOS_INFLUXDB_URL=http://pv-stack-influxdb:8086
# class: SECRET
SEPLOS_INFLUXDB_TOKEN=changeme
# class: SITE
SEPLOS_INFLUXDB_ORG=pv-stack
# class: SITE
SEPLOS_INFLUXDB_BUCKET=seplos
# class: TUNABLE
SEPLOS_INFLUXDB_WRITE_INTERVAL=5
# class: TUNABLE
SEPLOS_INFLUXDB_PUBLISH_MODE=changed
# class: SERVICE
SEPLOS_HEALTH_CHECK_INTERVAL=60
# class: TUNABLE
SEPLOS_HEALTH_STALE_TIMEOUT=120
# class: SERVICE
SEPLOS_LOG_LEVEL=INFO

# =============================================================================
# Fronius collectors (fronius-inverters, fronius-meter — templates/fronius)
# =============================================================================
# class: SITE
FRONIUS_INV_MODBUS_HOST=192.168.88.240
# class: SITE
FRONIUS_INV_MODBUS_PORT=502
# class: TUNABLE
FRONIUS_INV_MODBUS_TIMEOUT=3
# class: SITE
FRONIUS_INV_INVERTER_IDS=1,2,3,4
# class: SERVICE
FRONIUS_INV_MQTT_ENABLED=true
# class: SITE
FRONIUS_INV_MQTT_BROKER=mosquitto
# class: SITE
FRONIUS_INV_MQTT_PORT=1883
# class: SITE
FRONIUS_INV_MQTT_USERNAME=admin
# class: SECRET
FRONIUS_INV_MQTT_PASSWORD=changeme
# class: SITE
FRONIUS_INV_MQTT_PREFIX=fronius
# class: SERVICE
FRONIUS_INV_INFLUXDB_ENABLED=true
# class: SITE
FRONIUS_INV_INFLUXDB_URL=http://influxdb:8086
# class: SECRET
FRONIUS_INV_INFLUXDB_TOKEN=changeme
# class: SITE
FRONIUS_INV_INFLUXDB_ORG=pv-stack
# class: SITE
FRONIUS_INV_INFLUXDB_BUCKET=fronius
# class: SERVICE
FRONIUS_INV_LOG_LEVEL=INFO
# Modbus writes (power limits) — the gateway owns OV since 2026-10-20
# class: SERVICE
FRONIUS_INV_WRITE_ENABLED=true
# class: SITE
FRONIUS_MTR_MODBUS_HOST=192.168.88.240
# class: SITE
FRONIUS_MTR_MODBUS_PORT=502
# class: TUNABLE
FRONIUS_MTR_MODBUS_TIMEOUT=3
# class: SITE
FRONIUS_MTR_METER_IDS=240
# class: SERVICE
FRONIUS_MTR_MQTT_ENABLED=true
# class: SITE
FRONIUS_MTR_MQTT_BROKER=mosquitto
# class: SITE
FRONIUS_MTR_MQTT_PORT=1883
# class: SITE
FRONIUS_MTR_MQTT_USERNAME=admin
# class: SECRET
FRONIUS_MTR_MQTT_PASSWORD=changeme
# class: SITE
FRONIUS_MTR_MQTT_PREFIX=fronius
# class: SERVICE
FRONIUS_MTR_INFLUXDB_ENABLED=true
# class: SITE
FRONIUS_MTR_INFLUXDB_URL=http://influxdb:8086
# class: SECRET
FRONIUS_MTR_INFLUXDB_TOKEN=changeme
# class: SITE
FRONIUS_MTR_INFLUXDB_ORG=pv-stack
# class: SITE
FRONIUS_MTR_INFLUXDB_BUCKET=fronius
# class: SERVICE
FRONIUS_MTR_LOG_LEVEL=INFO

# =============================================================================
# Telegraf (telegraf-victron: GX MQTT → victron bucket; telegraf-policy: bus_raw)
# =============================================================================
# class: UNUSED
TELEGRAF_MODE=victron
# class: TUNABLE
TELEGRAF_INTERVAL=10s
# class: SITE
TELEGRAF_INFLUXDB_URL=http://influxdb:8086
# class: SECRET
TELEGRAF_INFLUXDB_TOKEN=changeme
# class: SITE
TELEGRAF_INFLUXDB_ORG=pv-stack
# class: SITE
TELEGRAF_INFLUXDB_BUCKET=victron
# The Ekrano GX broker
# class: SITE
TELEGRAF_MQTT_SERVER=ssl://192.168.88.235:8883
# class: SITE
TELEGRAF_MQTT_USERNAME=admin
# class: SECRET
TELEGRAF_MQTT_PASSWORD=changeme
# class: UNUSED
TELEGRAF_MQTT_INSECURE=true
# The GX portal id (topic root N/<id>/…)
# class: SITE
VICTRON_PORTAL_ID=c0619ab7d12b
# class: UNUSED
VICTRON_MONITOR_BATTERY=true
# class: UNUSED
VICTRON_MONITOR_GRID=true
# class: UNUSED
VICTRON_MONITOR_PVINVERTER=true
# class: UNUSED
VICTRON_MONITOR_VEBUS=true
# class: UNUSED
VICTRON_MONITOR_SYSTEM=true
# class: UNUSED
VICTRON_MONITOR_SOLARCHARGER=false
# class: UNUSED
VICTRON_MONITOR_TEMPERATURE=true

# =============================================================================
# Multi-Bus Gateway (meters, inverters, OV) + its ESPHome side
# =============================================================================
# class: SITE
MBG_UI_PORT=8080
# class: SITE
VMETER_PORT_START=1502
# class: SITE
VMETER_PORT_END=1512
# class: SITE
MBG_NODE_MQTT_USERNAME=mbg-node
# class: SECRET
MBG_NODE_MQTT_PASSWORD=changeme
# class: SECRET
MBG_COMPILER_TOKEN=changeme
# class: SECRET
MBG_ESPHOME_TOKEN=changeme
# class: SECRET
MBG_ALERTD_API_KEY=changeme
# class: UNUSED
ESPHOME_PORT=6052

# =============================================================================
# Other services
# =============================================================================
# class: SITE
PORTAINER_PORT=9443
# class: SERVICE
PORTAINER_IMAGE=portainer/portainer-ee:lts
# class: SITE
REDIS_PORT=6379
# class: SERVICE
WATCHTOWER_CLEANUP=true
# class: SERVICE
WATCHTOWER_SCHEDULE="0 0 4 * * *"
# shoutrrr URL — carries the Telegram bot token
# class: SECRET
WATCHTOWER_NOTIFICATION_URL=telegram://<bot token>@telegram?chats=<chat id>
# docker-monitor (container health → MQTT → alertd)
# class: SITE
DOCKER_MONITOR_MQTT_USER=admin
# class: SECRET
DOCKER_MONITOR_MQTT_PASS=changeme
# class: SERVICE
DOCKER_MONITOR_INTERVAL_S=30
# class: SERVICE
DOCKER_MONITOR_LOG_LEVEL=INFO
